<template>
	<view class="container">
		<view class="news-title">{{ news.title }}</view>
		<view class="news-content">{{ news.content }}</view>

		<view class="comments-section">
			<view class="comments-title">评论区</view>
			<view v-for="(comment, idx) in comments" :key="idx" class="comment-item">
				<text class="comment-user">{{ comment.username || comment.user }}</text>
				<text class="comment-text">{{ comment.content || comment.text }}</text>
			</view>
			<!-- 只允许普通用户评论 -->
			<view v-if="user.canComment" class="comment-input-bar">
				<input v-model="newComment" placeholder="写下你的评论..." class="comment-input" />
				<button @click="submitComment" class="submit-btn">发送</button>
			</view>
		</view>
	</view>
</template>

<script>
import { get, post } from '@/utils/request.js'
export default {
	data() {
		return {
			id: '',
			news: {
				title: '',
				content: ''
			},
			comments: [],
			user: {
				name: '',
				canComment: false
			},
			newComment: ''
		}
	},
	onLoad(options) {
		this.id = options.id
		this.user = {
			name: (uni.getStorageSync('userInfo') || {}).username || '游客',
			canComment: !!uni.getStorageSync('token')
		}
		this.fetchDetail()
		this.fetchComments()
	},
	methods: {
		async fetchDetail() {
			try {
				const res = await get(`/api/news/${this.id}`)
				if (res.data.success) this.news = res.data.data
			} catch (e) {
				console.warn('news detail fail', e)
			}
		},
		async fetchComments() {
			try {
				const res = await get(`/api/comments/${this.id}`)
				this.comments = res.data.data || []
			} catch (e) {
				console.warn('comments fail', e)
			}
		},
		async submitComment() {
			if (!this.newComment.trim()) return;
			try {
				const res = await post(`/api/comments/${this.id}`, { content: this.newComment })
				if (res.data.success) {
					this.comments.push(res.data.data)
					this.newComment = ''
				} else {
					uni.showToast({ title: '发送失败', icon: 'none' })
				}
			} catch (e) {
				console.warn('submit comment fail', e)
				uni.showToast({ title: '发送失败', icon: 'none' })
			}
		}
	}
}
</script>

<style>
.container {
	padding: 15px;
	background-color: #f8f8f8;
	min-height: 100vh;
}
.news-title {
	font-size: 20px;
	font-weight: bold;
	margin-bottom: 10px;
}
.news-content {
	font-size: 15px;
	color: #333;
	margin-bottom: 20px;
}
.comments-section {
	background: #fff;
	border-radius: 10px;
	padding: 15px;
}
.comments-title {
	font-size: 16px;
	font-weight: bold;
	margin-bottom: 10px;
}
.comment-item {
	margin-bottom: 8px;
	font-size: 14px;
	color: #444;
}
.comment-user {
	font-weight: bold;
	margin-right: 8px;
}
.comment-input-bar {
	display: flex;
	margin-top: 10px;
}
.comment-input {
	flex: 1;
	border: 1px solid #eee;
	border-radius: 5px;
	padding: 5px 10px;
	margin-right: 8px;
}
.submit-btn {
	background: #409eff;
	color: #fff;
	border-radius: 5px;
	padding: 5px 15px;
	font-size: 14px;
}
</style>
