<template>
	<view class="container">
		
		<!-- 个人信息卡片 -->
		<view class="profile-header">
			<image :src="userInfo.avatar || '/static/logo.png'" class="avatar" @click="handleAvatarClick" />
			<text class="username">{{ userInfo.username || '用户名' }}</text>
			<text class="user-bio">{{ userInfo.bio || '还没有个人简介' }}</text>
		</view>

		<!-- 个人数据统计 -->
		<view class="stats-section">
			<view class="stat-item" @click="goToFollowings">
				<text class="stat-value">{{ stats.follows || 0 }}</text>
				<text class="stat-label">关注</text>
			</view>
			<view class="stat-item" @click="goToFollowers">
				<text class="stat-value">{{ stats.followers || 0 }}</text>
				<text class="stat-label">粉丝</text>
			</view>
			<view class="stat-item">
				<text class="stat-value">{{ stats.posts || 0 }}</text>
				<text class="stat-label">动态</text>
			</view>
		</view>

		<!-- 功能菜单 -->
		<view class="menu-section">
			<view class="menu-item" @click="goToFavorites">
				<text class="menu-text">我的收藏</text>
				<text class="menu-arrow">></text>
			</view>
			<view class="menu-item" @click="goToSettings">
				<text class="menu-text">设置</text>
				<text class="menu-arrow">></text>
			</view>
			<view class="menu-item" @click="handleLogout">
				<text class="menu-text logout">退出登录</text>
			</view>
		</view>

		<CustomTabBar :currentIndex="-1" />
	</view>
</template>

<script>
import CustomTabBar from '@/components/CustomTabBar.uvue'
import TopRightIcon from '@/components/TopRightIcon.uvue'
import { get } from '@/utils/request.js'

export default {
	components: { CustomTabBar, TopRightIcon },
	data() {
		return {
			userInfo: {},
			stats: {
				follows: 0,
				followers: 0,
				posts: 0,
				favorites: 0
			}
		}
	},
	onLoad() {
		this.fetchProfile()
	},
	onShow() {
		// 从设置页面返回时刷新数据
		this.fetchProfile()
	},
	methods: {
		async fetchProfile() {
			try {
				const token = uni.getStorageSync('token')
				if (!token) {
					uni.reLaunch({ url: '/pages/login/login' })
					return
				}
				
				const res = await get('/api/users/profile')
				
				// 如果返回 401，说明 token 过期，request.js 已经处理了跳转
				if (res.statusCode === 401) {
					return
				}
				
				if (res.data && res.data.success) {
					this.userInfo = res.data.data || {}
					this.stats = res.data.data.stats || {
						follows: 0,
						followers: 0,
						posts: 0,
						favorites: 0
					}
				} else {
					console.error('fetch profile: response not success', res.data)
					// 如果是 token 相关错误，不显示错误提示（因为已经处理了跳转）
					if (res.data?.message && res.data.message.includes('凭证')) {
						return
					}
					uni.showToast({ title: res.data?.message || '获取用户信息失败', icon: 'none' })
				}
			} catch (e) {
				console.error('fetch profile error', e)
				// 网络错误或其他错误
				if (e.errMsg && !e.errMsg.includes('401')) {
					uni.showToast({ title: '获取用户信息失败', icon: 'none', duration: 3000 })
				}
			}
		},
		handleAvatarClick() {
			this.goToSettings()
		},
		goToSettings() {
			uni.navigateTo({ url: '/pages/profile/settings' })
		},
		goToFavorites() {
			uni.navigateTo({ url: '/pages/profile/favorites' })
		},
		goToFollowings() {
			uni.navigateTo({ url: '/pages/profile/followings' })
		},
		goToFollowers() {
			uni.navigateTo({ url: '/pages/profile/followers' })
		},
		handleLogout() {
			uni.showModal({
				title: '确认退出',
				content: '确定要退出登录吗？',
				success: (res) => {
					if (res.confirm) {
						// 清除登录信息
						uni.removeStorageSync('token');
						uni.removeStorageSync('userInfo');
						
						// 跳转到登录页面
						uni.reLaunch({
							url: '/pages/login/login'
						});
					}
				}
			});
		}
	}
}
</script>

<style>
.container {
	background-color: #f8f8f8;
	min-height: 100vh;
	padding-bottom: 60px;
}

.profile-header {
	background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
	padding: 40px 20px 30px 20px;
	display: flex;
	flex-direction: column;
	align-items: center;
	color: #fff;
}

.avatar {
	width: 80px;
	height: 80px;
	border-radius: 50%;
	background: #fff;
	margin-bottom: 15px;
	border: 3px solid #fff;
}

.username {
	font-size: 22px;
	font-weight: bold;
	margin-bottom: 8px;
}

.user-bio {
	font-size: 14px;
	opacity: 0.9;
}

.stats-section {
	display: flex;
	flex-direction: row;
	background: #fff;
	margin: -20px 15px 15px 15px;
	border-radius: 10px;
	box-shadow: 0 2px 8px rgba(0,0,0,0.08);
	padding: 20px 0;
}

.stat-item {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	border-right: 1px solid #eee;
}

.stat-item:last-child {
	border-right: none;
}

.stat-value {
	font-size: 24px;
	font-weight: bold;
	color: #333;
	margin-bottom: 5px;
}

.stat-label {
	font-size: 13px;
	color: #999;
}

.menu-section {
	background: #fff;
	margin: 0 15px;
	border-radius: 10px;
	overflow: hidden;
}

.menu-item {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 16px 20px;
	border-bottom: 1px solid #f5f5f5;
}

.menu-item:last-child {
	border-bottom: none;
}

.menu-text {
	font-size: 15px;
	color: #333;
}

.logout {
	color: #e54d42;
}

.menu-arrow {
	font-size: 16px;
	color: #999;
}
</style>
