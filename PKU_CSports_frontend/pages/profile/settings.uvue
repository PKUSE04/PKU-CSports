<template>
	<view class="container">
		<view class="header">
			<text class="title">设置</text>
		</view>
		
		<view class="form-section">
			<view class="form-item">
				<text class="label">头像</text>
				<view class="avatar-upload" @click="chooseAvatar">
					<image v-if="formData.avatar" :src="formData.avatar" class="avatar-preview" />
					<text v-else class="avatar-placeholder">点击选择头像</text>
				</view>
			</view>
			
			<view class="form-item">
				<text class="label">个人简介</text>
				<textarea v-model="formData.bio" placeholder="请输入个人简介" class="textarea" maxlength="200" />
			</view>
			
			<view class="form-item">
				<text class="label">主队</text>
				<picker mode="selector" :range="teamOptions" range-key="name" :value="selectedTeamIndex" @change="onTeamChange">
					<view class="picker">
						<text>{{ selectedTeamName || '请选择主队' }}</text>
						<text class="picker-arrow">></text>
					</view>
				</picker>
			</view>
		</view>
		
		<button class="save-btn" @click="saveSettings" :loading="saving">保存</button>
	</view>
</template>

<script>
import { get, patch, post } from '@/utils/request.js'
import { baseURL } from '@/utils/request.js'

export default {
	data() {
		return {
			formData: {
				avatar: '',
				bio: '',
				fav_team_id: null
			},
			teams: [],
			selectedTeamIndex: 0,
			saving: false
		}
	},
	computed: {
		teamOptions() {
			return [{ id: null, name: '不设置主队' }, ...this.teams]
		},
		selectedTeamName() {
			if (this.formData.fav_team_id === null) {
				return '不设置主队'
			}
			const team = this.teams.find(t => t.id === this.formData.fav_team_id)
			return team ? team.name : '请选择主队'
		}
	},
	onLoad() {
		this.fetchUserInfo()
		this.fetchTeams()
	},
	methods: {
		async fetchUserInfo() {
			try {
				const res = await get('/api/users/profile')
				if (res.data.success) {
					this.formData.avatar = res.data.data.avatar || ''
					this.formData.bio = res.data.data.bio || ''
					this.formData.fav_team_id = res.data.data.fav_team_id || null
				}
			} catch (e) {
				console.error('fetch user info error', e)
			}
		},
		async fetchTeams() {
			try {
				const res = await get('/api/teams')
				if (res.data.success) {
					this.teams = res.data.data || []
				}
			} catch (e) {
				console.error('fetch teams error', e)
			}
		},
		chooseAvatar() {
			uni.chooseImage({
				count: 1,
				sizeType: ['compressed'],
				sourceType: ['album', 'camera'],
				success: async (res) => {
					const tempFilePath = res.tempFilePaths[0]
					// 上传头像
					uni.uploadFile({
						url: `${baseURL}/api/upload`,
						filePath: tempFilePath,
						name: 'file',
						header: {
							Authorization: `Bearer ${uni.getStorageSync('token')}`
						},
						success: (uploadRes) => {
							try {
								const data = JSON.parse(uploadRes.data)
								if (data.success) {
									this.formData.avatar = data.data.url
									uni.showToast({ title: '头像上传成功', icon: 'success' })
								} else {
									uni.showToast({ title: '上传失败', icon: 'none' })
								}
							} catch (e) {
								console.error('parse upload response error', e)
								uni.showToast({ title: '上传失败', icon: 'none' })
							}
						},
						fail: (e) => {
							console.error('upload avatar error', e)
							uni.showToast({ title: '上传失败', icon: 'none' })
						}
					})
				}
			})
		},
		onTeamChange(e) {
			const index = parseInt(e.detail.value)
			if (index === 0) {
				this.formData.fav_team_id = null
			} else {
				this.formData.fav_team_id = this.teams[index - 1].id
			}
		},
		async saveSettings() {
			this.saving = true
			try {
				const res = await patch('/api/users/profile', this.formData)
				if (res.data.success) {
					uni.showToast({ title: '保存成功', icon: 'success' })
					setTimeout(() => {
						uni.navigateBack()
					}, 1000)
				} else {
					uni.showToast({ title: res.data.message || '保存失败', icon: 'none' })
				}
			} catch (e) {
				console.error('save settings error', e)
				uni.showToast({ title: '保存失败', icon: 'none' })
			} finally {
				this.saving = false
			}
		}
	}
}
</script>

<style>
.container {
	background-color: #f8f8f8;
	min-height: 100vh;
	padding: 20px;
}

.header {
	margin-bottom: 20px;
}

.title {
	font-size: 24px;
	font-weight: bold;
	color: #333;
}

.form-section {
	background: #fff;
	border-radius: 10px;
	padding: 20px;
	margin-bottom: 20px;
}

.form-item {
	margin-bottom: 20px;
}

.form-item:last-child {
	margin-bottom: 0;
}

.label {
	font-size: 15px;
	color: #333;
	margin-bottom: 10px;
	display: block;
}

.avatar-upload {
	width: 80px;
	height: 80px;
	border-radius: 50%;
	border: 2px dashed #ddd;
	display: flex;
	align-items: center;
	justify-content: center;
	overflow: hidden;
}

.avatar-preview {
	width: 100%;
	height: 100%;
}

.avatar-placeholder {
	font-size: 12px;
	color: #999;
	text-align: center;
	padding: 10px;
}

.textarea {
	width: 100%;
	min-height: 100px;
	padding: 10px;
	border: 1px solid #eee;
	border-radius: 8px;
	font-size: 14px;
	color: #333;
}

.picker {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 12px;
	border: 1px solid #eee;
	border-radius: 8px;
	background: #fff;
}

.picker-arrow {
	color: #999;
	font-size: 16px;
}

.save-btn {
	width: 100%;
	background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
	color: #fff;
	padding: 14px;
	border-radius: 8px;
	font-size: 16px;
	font-weight: bold;
}
</style>


