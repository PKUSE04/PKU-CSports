<template>
  <view class="content">
    <view class="topBox">
      <h3>WELCOME</h3>
      <h3>欢迎使用PKU-CSports</h3>
    </view>

    <view class="inputBox">
      <view class="ipt">
        <h4>手机号</h4>
        <input v-model="phone" type="text" placeholder="请输入手机号码" />
      </view>

      <view class="ipt">
        <h4>密码</h4>
        <input v-model="password" type="password" placeholder="请输入密码" />
      </view>

      <button class="loginBtn" @click="login">登录</button>
      <button class="registerBtn" @click="toRegister">注册</button>
    </view>
  </view>
</template>

<script>
export default {
  data() {
    return {
      phone: '',
      password: ''
    }
  },
  methods: {
    async login() {
      if (!this.phone || !this.password) {
        uni.showToast({
          title: '请输入完整信息',
          icon: 'none'
        })
        return
      }

      // 🧠 模拟后端验证逻辑
      // 这里你可以换成真实接口请求，如 uni.request({url: 'xxx/login', method:'POST', data:{...}})
      const mockUsers = [
        { phone: '123456', password: '123456', role: 'user' },
        { phone: '19900000000', password: '123456', role: 'user' }
      ]

      const found = mockUsers.find(
        u => u.phone === this.phone && u.password === this.password
      )

      if (!found) {
        uni.showToast({
          title: '手机号或密码错误',
          icon: 'none'
        })
        return
      }

      // 登录成功后存储用户信息
      uni.setStorageSync('userInfo', found)

      uni.showToast({
        title: '登录成功',
        icon: 'success'
      })

      // 延迟跳转，根据身份进入不同页面
      setTimeout(() => {
        if (found.role === 'admin') {
          uni.navigateTo({ url: '/pages/admin/index/index' })
        } else {
          uni.navigateTo({ url: '/pages/home/index/index' })
        }
      }, 800)
    },

    toRegister() {
      uni.navigateTo({
        url: '/pages/register/register'
      })
    }
  }
}
</script>

