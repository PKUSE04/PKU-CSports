<template>
	<view class="container">
		<TopRightIcon />
		
		<!-- 主队信息头部 -->
		<view class="team-header" v-if="teamInfo">
			<image :src="teamInfo.logo || '/static/logo.png'" class="team-logo" />
			<text class="team-name">{{ teamInfo.name }}</text>
			<text class="team-slogan" v-if="teamInfo.account">{{ teamInfo.account.bio || '为你喜爱的球队加油！' }}</text>
			<text class="team-slogan" v-else>为你喜爱的球队加油！</text>
		</view>
		
		<view v-else class="empty-team">
			<text class="empty-text">还没有设置主队</text>
			<button class="set-team-btn" @click="goToSettings">去设置</button>
		</view>

		<!-- 赛事信息 -->
		<view class="section" v-if="teamInfo && teamInfo.recent_matches && teamInfo.recent_matches.length > 0">
			<view class="section-title">
				<text class="title-text">近期赛事</text>
			</view>
			<view class="match-list">
				<view v-for="(match, index) in teamInfo.recent_matches" :key="index" class="match-item" @click="goToMatchDetail(match.id)">
					<text class="match-time">{{ formatDateTime(match.date_time) }}</text>
					<view class="match-info">
						<text class="team-home">{{ match.home_team_name }}</text>
						<text class="score">{{ formatScore(match) }}</text>
						<text class="team-away">{{ match.away_team_name }}</text>
					</view>
					<text class="match-status">{{ match.status }}</text>
				</view>
			</view>
		</view>

		<!-- 主队动态 -->
		<view class="section" v-if="teamInfo && teamInfo.recent_posts && teamInfo.recent_posts.length > 0">
			<view class="section-title">
				<text class="title-text">主队动态</text>
			</view>
			<view class="post-list">
				<view v-for="(post, index) in teamInfo.recent_posts" :key="index" class="post-item" @click="goToPostDetail(post.id)">
					<view class="post-header">
						<image :src="post.author_avatar || '/static/logo.png'" class="post-avatar" />
						<view class="post-info">
							<text class="post-author">{{ post.author_name }}</text>
							<text class="post-time">{{ formatTime(post.created_at) }}</text>
						</view>
					</view>
					<text class="post-title">{{ post.title }}</text>
					<text class="post-content">{{ post.content }}</text>
				</view>
			</view>
		</view>

		<CustomTabBar :currentIndex="-1" />
	</view>
</template>

<script>
import CustomTabBar from '@/components/CustomTabBar.uvue'
import TopRightIcon from '@/components/TopRightIcon.uvue'
import { get } from '@/utils/request.js'

export default {
	components: { CustomTabBar, TopRightIcon },
	data() {
		return {
			teamInfo: null
		}
	},
	onLoad() {
		this.fetchTeamInfo()
	},
	onShow() {
		// 从设置页面返回时刷新数据
		this.fetchTeamInfo()
	},
	methods: {
		async fetchTeamInfo() {
			try {
				const token = uni.getStorageSync('token')
				if (!token) {
					return
				}
				
				const res = await get('/api/teams/myteam')
				if (res.data.success) {
					this.teamInfo = res.data.data
				}
			} catch (e) {
				console.error('fetch team info error', e)
			}
		},
		goToSettings() {
			uni.navigateTo({ url: '/pages/profile/settings' })
		},
		goToMatchDetail(matchId) {
			uni.navigateTo({ url: `/pages/matches/detail?id=${matchId}` })
		},
		goToPostDetail(postId) {
			uni.navigateTo({ url: `/pages/news/news-detail?id=${postId}` })
		},
		formatDateTime(dateTimeStr) {
			if (!dateTimeStr) return ''
			const date = new Date(dateTimeStr)
			const month = String(date.getMonth() + 1).padStart(2, '0')
			const day = String(date.getDate()).padStart(2, '0')
			const hours = String(date.getHours()).padStart(2, '0')
			const minutes = String(date.getMinutes()).padStart(2, '0')
			return `${month}.${day} ${hours}:${minutes}`
		},
		formatScore(match) {
			if (match.status === '未开始' || !match.score_home && !match.score_away) {
				return 'vs'
			}
			return `${match.score_home || 0}-${match.score_away || 0}`
		},
		formatTime(timeStr) {
			if (!timeStr) return ''
			const date = new Date(timeStr)
			const now = new Date()
			const diff = now - date
			const minutes = Math.floor(diff / 60000)
			const hours = Math.floor(diff / 3600000)
			const days = Math.floor(diff / 86400000)
			
			if (minutes < 1) return '刚刚'
			if (minutes < 60) return `${minutes}分钟前`
			if (hours < 24) return `${hours}小时前`
			if (days < 7) return `${days}天前`
			return timeStr.slice(5, 16)
		}
	}
}
</script>

<style>
.container {
	background-color: #f8f8f8;
	min-height: 100vh;
	padding-bottom: 60px;
}

.team-header {
	background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
	padding: 40px 20px 30px 20px;
	display: flex;
	flex-direction: column;
	align-items: center;
	color: #fff;
}

.team-logo {
	width: 80px;
	height: 80px;
	border-radius: 50%;
	background: #fff;
	margin-bottom: 15px;
	border: 3px solid #fff;
}

.team-name {
	font-size: 24px;
	font-weight: bold;
	margin-bottom: 8px;
}

.team-slogan {
	font-size: 14px;
	opacity: 0.9;
}

.section {
	margin: 15px;
}

.section-title {
	margin-bottom: 12px;
}

.title-text {
	font-size: 18px;
	font-weight: bold;
	color: #333;
}

.match-list {
	background: #fff;
	border-radius: 10px;
	overflow: hidden;
}

.match-item {
	padding: 15px;
	border-bottom: 1px solid #f5f5f5;
}

.match-item:last-child {
	border-bottom: none;
}

.match-time {
	font-size: 13px;
	color: #999;
	display: block;
	margin-bottom: 8px;
}

.match-info {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 6px;
}

.team-home, .team-away {
	font-size: 16px;
	font-weight: bold;
	color: #333;
	flex: 1;
}

.team-away {
	text-align: right;
}

.score {
	font-size: 15px;
	color: #666;
	margin: 0 10px;
}

.match-status {
	font-size: 12px;
	color: #409eff;
}

.post-list {
	background: #fff;
	border-radius: 10px;
	overflow: hidden;
}

.post-item {
	padding: 15px;
	border-bottom: 1px solid #f5f5f5;
}

.post-item:last-child {
	border-bottom: none;
}

.post-header {
	display: flex;
	align-items: center;
	margin-bottom: 10px;
}

.post-avatar {
	width: 40px;
	height: 40px;
	border-radius: 50%;
	margin-right: 10px;
}

.post-info {
	display: flex;
	flex-direction: column;
}

.post-author {
	font-size: 15px;
	font-weight: bold;
	color: #333;
	margin-bottom: 3px;
}

.post-time {
	font-size: 12px;
	color: #999;
}

.post-title {
	font-size: 15px;
	font-weight: bold;
	color: #333;
	margin-bottom: 6px;
}

.post-content {
	font-size: 14px;
	color: #666;
	line-height: 1.6;
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
}

.empty-team {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 60px 20px;
}

.empty-text {
	font-size: 16px;
	color: #999;
	margin-bottom: 20px;
}

.set-team-btn {
	background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
	color: #fff;
	padding: 10px 20px;
	border-radius: 20px;
	font-size: 14px;
}
</style>
