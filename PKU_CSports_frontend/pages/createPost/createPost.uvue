<template>
  <view class="page">

    <view class="editor-card">
      <input
        class="title-input"
        v-model="title"
        placeholder="请输入标题（例如：校园杯首战快讯）"
      />

      <view class="module-selector">
        <text class="module-label">所属模块（可选）</text>
        <view class="module-options">
          <view
            class="module-chip"
            :class="{ active: moduleType === '' }"
            @click="selectModule('')"
          >
            不选择
          </view>
          <view
            v-for="opt in moduleOptions"
            :key="opt.value"
            :class="['module-chip', { active: moduleType === opt.value }]"
            @click="selectModule(opt.value)"
          >
            {{ opt.label }}
          </view>
        </view>
      </view>


      <view class="content-wrapper">
        <textarea
          class="content-input"
          v-model="content"
          placeholder="分享比赛瞬间、战报或想法…"
          autoHeight
        />
      
        <!-- 底部轻量工具栏 -->
        <view class="editor-toolbar">
          <view class="tool-btn" @click="toggleEmoji">😊</view>
          <view class="tool-btn" @click="chooseImage">🖼</view>
          <view class="tool-btn" @click="chooseVideo">🎥</view>
      
          <text class="toolbar-tip"># 输入话题</text>
        </view>
      </view>
	  
	  <view v-if="tags.length" class="tag-list">
	    <view class="tag" v-for="(t, i) in tags" :key="t">
	      #{{ t }}
	      <text class="remove" @click="removeTag(i)">×</text>
	    </view>
	  </view>


      <view class="media-list">
        <view class="media-item" v-for="(m, idx) in media" :key="m.path">
          <image v-if="m.type==='image'" :src="m.path" class="media-thumb" mode="aspectFill" />
          <video v-else-if="m.type==='video'" :src="m.path" class="media-thumb" controls />
          <text class="media-remove" @click="removeMedia(idx)">删除</text>
        </view>
      </view>

      <view v-if="showEmoji" class="emoji-picker">
        <text
          class="emoji"
          v-for="e in emojis"
          :key="e"
          @click="insertEmoji(e)"
        >{{ e }}</text>
      </view>

      <view class="submit-row">
        <text class="error" v-if="errorMsg">{{ errorMsg }}</text>
        <button class="submit-btn" :disabled="loading" @click="submitPost">
          {{ loading ? '发布中...' : '发布' }}
        </button>
      </view>
    </view>
  </view>
</template>

<script>
import { post, baseURL } from '@/utils/request.js'
export default {
  data() {
    return {
      title: '',
      content: '',
      tags: [],
      tagInput: '',
      media: [], // { type: 'image'|'video', path }
      showEmoji: false,
      emojis: ['😀','😃','😂','😍','👍','🔥','🎉','🤔','🙏','💯'],
      loading: false,
      errorMsg: '',
      userRole: 'user',
      moduleType: 'flash',
      moduleOptions: [
        { label: '前线快讯', value: 'flash' },
        { label: '赛后战报', value: 'report' }
      ]
    }
  },
  computed: {
    canPublish() {
      return this.userRole === 'association' || this.userRole === 'admin'
    }
  },
  onShow() {
    const info = uni.getStorageSync('userInfo') || {}
    this.userRole = info.role || 'user'
    if (!this.canPublish) {
      uni.showToast({ title: '仅协会方/管理员可发布', icon: 'none' })
      setTimeout(() => uni.navigateBack(), 800)
    }
  },
  methods: {
    addTag() {
      const t = (this.tagInput || '').trim();
      if (!t) return;
      if (this.tags.includes(t)) {
        this.errorMsg = '话题已存在';
        return;
      }
      this.tags.push(t);
      this.tagInput = '';
      this.errorMsg = '';
    },
    removeTag(i) {
      this.tags.splice(i,1);
    },
    async chooseImage() {
      try {
        const res = await new Promise((resolve, reject) => {
          uni.chooseImage({ count: 9, success: resolve, fail: reject })
        });
        const paths = res.tempFilePaths || res.tempFiles && res.tempFiles.map(f=>f.path) || [];
        paths.forEach(p => this.media.push({ type: 'image', path: p }));
      } catch (err) {
        console.warn('chooseImage cancelled or failed', err);
      }
    },
    async chooseVideo() {
      try {
        const res = await new Promise((resolve, reject) => {
          uni.chooseVideo({ success: resolve, fail: reject })
        });
        const path = res.tempFilePath || res.tempFilePath;
        if (path) this.media.push({ type: 'video', path });
      } catch (err) {
        console.warn('chooseVideo cancelled or failed', err);
      }
    },
    removeMedia(idx) {
      this.media.splice(idx, 1);
    },
    toggleEmoji() {
      this.showEmoji = !this.showEmoji;
    },
    insertEmoji(e) {
      this.content = (this.content || '') + e;
      this.showEmoji = false;
    },
    selectModule(val) {
      this.moduleType = val;
    },
    async uploadAllMedia() {
      const uploaded = [];
      const token = uni.getStorageSync('token') || '';
      for (const m of this.media) {
        try {
          const res = await new Promise((resolve, reject) => {
            uni.uploadFile({
              url: `${baseURL}/api/upload`,
              filePath: m.path,
              name: 'file',
              formData: {
                type: m.type
              },
              header: token ? { Authorization: `Bearer ${token}` } : {},
              success: resolve,
              fail: reject
            });
          });
          let data = {};
          try {
            data = typeof res.data === 'string' ? JSON.parse(res.data) : res.data;
          } catch (e) {
            console.warn('parse upload response fail', e);
          }
          const url = data?.url || data?.data?.url;
          if (url) {
            uploaded.push({ type: m.type, url });
          }
        } catch (e) {
          console.warn('upload media fail', e);
        }
      }
      return uploaded;
    },
    async submitPost() {
      if (!this.title.trim()) {
        this.errorMsg = '请填写标题';
        return;
      }
      if (!this.content.trim() && this.media.length === 0) {
        this.errorMsg = '请输入内容或添加媒体';
        return;
      }
      if (!this.moduleType) {
        this.errorMsg = '请选择所属模块';
        return;
      }
      this.loading = true;
      this.errorMsg = '';

      try {
        let mediaPayload = [];
        if (this.media.length > 0) {
          mediaPayload = await this.uploadAllMedia();
        }

        const payload = {
          title: this.title.trim() || this.content.slice(0, 30) || '帖子',
          content: this.content,
          type: this.moduleType,
          tags: this.tags,
          media: mediaPayload
        };

        const res = await post('/api/news', payload);
        const result = res.data || {};
        if (result.success) {
          uni.showToast({ title: '发布成功', icon: 'success' });
          setTimeout(() => {
            uni.navigateBack();
          }, 800);
        } else {
          this.errorMsg = result.message || '发布失败';
        }
      } catch (err) {
        console.error('submitPost error', err);
        this.errorMsg = '发布出错，请稍后重试';
      } finally {
        this.loading = false;
      }
    }
  }
}
</script>

<style>
.page { 
	padding: 12px; 
	background-color: #f5f7fa; 
	min-height: 100vh; 
}
.title-input { 
	width: 100%; 
	font-size: 16px; 
	padding: 10px 12px; 
	border-radius: 8px; 
	background: #fafafa; 
	border: 1px solid #eee; 
}
.module-selector { 
	display: flex; 
	flex-direction: column; 
	gap: 6px; 
}
.module-label { 
	font-size: 14px; 
	color: #666; 
}
.module-options { 
	display: flex; 
	flex-direction: row; 
	gap: 8px; 
}
.module-chip {
	padding: 6px 12px;
	border-radius: 16px;
	background: #f5f7fa;
	font-size: 13px;
	color: #666;
}

.module-chip.active {
	background: #409eff;
	color: #fff;
}

.header { 
	padding: 6px 0 12px; 
	display: flex; 
	align-items: center; 
	justify-content: space-between; 
}
.title { 
	font-size: 20px; 
	font-weight: 700; 
}
.editor-card { 
	background: #fff; 
	border-radius: 12px; 
	padding: 14px; 
	box-shadow: 0 6px 16px rgba(0,0,0,0.06); 
	display: flex; 
	flex-direction: column; 
	gap: 12px; 
}
.content-wrapper {
  border: 1px solid #eee;
  border-radius: 12px;
  padding: 10px;
  background: #fafafa;
}

.content-input {
  width: 100%;
  min-height: 140px;
  font-size: 15px;
  line-height: 1.6;
  border: none;
  background: transparent;
}
.controls { 
	display: flex; 
	flex-direction: column;
	gap: 12px; 
}
.tags { 
	display: flex; 
	align-items: center; 
	gap: 8px; 
	flex-wrap: wrap; 
}
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.tag {
  background: #eef6ff;
  color: #409eff;
  padding: 6px 10px;
  border-radius: 16px;
  font-size: 13px;
}

.tag .remove { 
	margin-left: 6px; 
	color: #999; 
}
.tag-input { border: 1px dashed #ddd; padding: 6px 8px; border-radius: 8px; min-width: 140px; }
.add-tag { 
	background: #409eff; 
	color: #fff; 
	padding: 6px 10px; 
	border-radius: 8px; 
}
.editor-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12px;
  margin-top: 6px;
}

.tool-btn {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: #f0f2f5;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  font-size: 16px;
}

.tool-btn:active {
  background: #e5e7eb;
}

.toolbar-tip {
  font-size: 12px;
  color: #999;
  margin-left: auto;
}
.media-list { 
	display: flex; 
	flex-direction: row;
	gap: 8px; 
	flex-wrap: wrap; 
} 
.media-item { 
	position: relative; 
	border-radius: 10px; 
	overflow: hidden; 
} 
.media-thumb { 
	width: 120px; 
	height: 80px; 
	border-radius: 8px; 
} 
.media-remove { 
	position: absolute; 
	right: 4px; 
	top: 4px; 
	background: rgba(0,0,0,0.5); 
	color: #fff; 
	padding: 2px 6px; 
	border-radius: 12px; 
	font-size: 12px; 
}
.emoji-picker { 
	margin-top: 10px; 
	padding: 8px; 
	background: #fafafa; 
	border-radius: 8px; 
	display: flex; 
	gap: 8px; 
	flex-wrap: wrap; 
	flex-direction: row; 
} 
.emoji { 
	font-size: 20px; 
	padding: 6px; 
}

.submit-row { 
	display: flex; 
	justify-content: space-between; 
	align-items: center; 
	margin-top: 12px; 
}
.submit-btn { 
	background: linear-gradient(135deg,#667eea 0%,#764ba2 100%); 
	color: #fff; 
	padding: 8px 18px; 
	border-radius: 8px; 
}
.error { 
	color: #e54d42; 
}
</style>
